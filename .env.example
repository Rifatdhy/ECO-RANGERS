# Ganti dengan alamat IP lokal Anda atau URL API production
# Contoh untuk pengembangan lokal di emulator Android:
# API_BASE_URL=http://10.0.2.2:8000

# Contoh untuk pengembangan lokal di browser Chrome atau perangkat fisik:
# Ganti 192.168.x.x dengan alamat IP mesin Anda
API_BASE_URL=http://192.168.0.102:8000

# Contoh untuk production:
# API_BASE_URL=https://api.ecorangers.com
