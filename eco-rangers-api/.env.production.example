APP_NAME=Eco Rangers API
APP_ENV=production
# Ganti dengan key yang benar (php artisan key:generate di server produksi)
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.ecorangers.com

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
# Sertakan 'sentry' saat SENTRY_LARAVEL_DSN terisi untuk menuangkan log → Sentry
LOG_STACK=single,sentry
LOG_LEVEL=warning

# ============================================================
# DATABASE — gunakan MySQL/PostgreSQL di produksi, BUKAN SQLite
# ============================================================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=eco_rangers
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true

QUEUE_CONNECTION=database
CACHE_STORE=database

FILESYSTEM_DISK=local

MAIL_MAILER=log

# ============================================================
# KEAMANAN — WAJIB diubah & dijaga rahasia
# ============================================================
# CORS: daftar origin frontend, dipisah koma. JANGAN '*' di produksi.
CORS_ALLOWED_ORIGINS=https://app.ecorangers.com

# Umur token Sanctum (menit). Default 7 hari = 10080.
SANCTUM_TOKEN_EXPIRATION=10080

# Wajib false di produksi — mengaktifkan /api/testing/* (wipe DB).
APP_TESTING_ROUTES=false

# Password admin produksi — WAJIB diganti dengan string acak yang kuat
ADMIN_EMAIL=admin@ecorangers.com
ADMIN_PASSWORD=GANTI-DENGAN-PASSWORD-ACAK-YANG-SANGAT-KUAT

# Rate limit login (percobaan per menit)
THROTTLE_LOGIN=10

# Error tracking Sentry (isi DSN proyek Sentry produksi)
SENTRY_LARAVEL_DSN=
SENTRY_RELEASE=eco-rangers@1.0.0